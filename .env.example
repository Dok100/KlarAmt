# Claude API (Pflicht)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: Modell überschreiben (Standard: claude-haiku-4-5-20251001)
CLAUDE_MODEL=

# Rate-Limiting via Upstash Redis (Pflicht in Produktion, sonst KEIN Schutz)
# Kostenloser Account: https://console.upstash.com  → Redis-Datenbank anlegen → "REST API"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Limits anpassen (Standard: 3 pro IP/Tag, 300 global/Tag)
RATE_LIMIT_IP=3
RATE_LIMIT_GLOBAL_DAY=300
